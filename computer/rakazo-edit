#!/bin/sh
# Open a text file (or blank buffer) in Mousepad and raise the window.
set -eu
DISPLAY="${DISPLAY:-:1}"
export DISPLAY

if [ "$#" -gt 0 ]; then
  mousepad -- "$@" &
else
  mousepad &
fi
pid=$!

i=0
while [ "$i" -lt 40 ]; do
  wid=$(xdotool search --onlyvisible --class Mousepad 2>/dev/null | tail -1 || true)
  if [ -n "${wid:-}" ]; then
    xdotool windowactivate --sync "$wid" 2>/dev/null || true
    xdotool windowraise "$wid" 2>/dev/null || true
    exit 0
  fi
  i=$((i + 1))
  sleep 0.1
done

wait "$pid" 2>/dev/null || true
